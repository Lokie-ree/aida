{
  "name": "pelican-ai",
  "description": "Pelican AI - Navigate AI with Confidence. Platform-agnostic guidance that works with ANY AI tool you already use, designed specifically for Louisiana educators.",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev",
    "build": "vite build",
    "lint": "tsc -p convex -noEmit --pretty false && tsc -p . -noEmit --pretty false && convex dev --once && vite build",
    "test": "vitest",
    "test:once": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config vitest.browser.config.mts",
    "test:e2e:watch": "vitest --watch --config vitest.browser.config.mts",
    "test:e2e:ui": "vitest --ui --config vitest.browser.config.mts",
    "ingest-rag": "tsx scripts/ingest-rag.ts",
    "ingest-rag:dry-run": "tsx scripts/ingest-rag.ts --dry-run",
    "email:dev": "email dev --dir src/emails --port 3001",
    "email:export": "email export --dir src/emails --outDir dist/emails"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.77",
    "@convex-dev/action-cache": "^0.2.11",
    "@convex-dev/agent": "^0.2.12",
    "@convex-dev/better-auth": "^0.9.11",
    "@convex-dev/rag": "^0.5.4",
    "@convex-dev/rate-limiter": "^0.3.0",
    "@convex-dev/resend": "^0.1.13",
    "@convex-dev/workflow": "^0.2.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@react-email/tailwind": "^2.0.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "better-auth": "^1.3.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.30.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "openai": "^6.10.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-email": "^5.0.6",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.68.0",
    "react-router-dom": "^7.10.1",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.1",
    "@react-email/preview-server": "^5.0.6",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "4.0.15",
    "@vitest/browser-playwright": "4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "4.0.15",
    "convex-test": "^0.0.38",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.57.0",
    "postcss": "~8.5.6",
    "prettier": "^3.7.4",
    "shadcn": "^3.5.1",
    "tailwindcss": "~4.1.17",
    "terser": "^5.44.1",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^6.4.1",
    "vitest": "^4.0.15"
  }
}
